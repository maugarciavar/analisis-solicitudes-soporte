# Copie este archivo como .env y ajuste los valores. El archivo .env no se sube al repositorio.

# Base de datos. SQLite por defecto; para PostgreSQL:
# DATABASE_URL=postgresql+psycopg://usuario:clave@host:5432/soporte
DATABASE_URL=sqlite:///./solicitudes.db

# API externa de clientes (mock_crm.py)
CRM_URL=http://localhost:9000

# Modelo de lenguaje. Si OPENAI_API_KEY queda vacía se usa un modelo simulado.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Precio en USD por millón de tokens
PRECIO_ENTRADA_POR_MILLON=0.15
PRECIO_SALIDA_POR_MILLON=0.60

# Reintentos hacia el CRM
CRM_MAX_INTENTOS=3
CRM_ESPERA_BASE_SEGUNDOS=0.5
CRM_ESPERA_MAXIMA_SEGUNDOS=4
CRM_TIMEOUT_SEGUNDOS=2
CRM_TIEMPO_TOTAL_SEGUNDOS=8
